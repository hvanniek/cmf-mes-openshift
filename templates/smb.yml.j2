---
apiVersion: v1
kind: Secret
metadata:
  name: {{ cmf_db_server_name }}-smbcreds 
  namespace: "{{ cmf.environment.name }}"
stringData:
  username: "{{ db_username }}" 
  password: "{{ admin_password }}"

---
 apiVersion: storage.k8s.io/v1
 kind: StorageClass
 metadata:
   name: cmf-smb-share-sc 
 provisioner: smb.csi.k8s.io
 parameters:
   source: "//{{ cmf_db_server_name }}.{{ cmf.environment.name }}.svc.cluster.local/shares"
   csi.storage.k8s.io/provisioner-secret-name: {{ cmf_db_server_name }}-smbcreds  
   csi.storage.k8s.io/provisioner-secret-namespace: "{{ cmf.environment.name }}"
   csi.storage.k8s.io/node-stage-secret-name: {{ cmf_db_server_name }}-smbcreds  
   csi.storage.k8s.io/node-stage-secret-namespace: "{{ cmf.environment.name }}"
 reclaimPolicy: Retain
 volumeBindingMode: Immediate
 mountOptions:
   - dir_mode=0777
   - file_mode=0777
   - uid=1001
   - gid=1001
   - noperm
   - mfsymlinks
   - cache=strict
   - noserverino